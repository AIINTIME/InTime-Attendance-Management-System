PORT=5055
NODE_ENV=development

# MongoDB Atlas connection string. Never commit the real value.
MONGODB_URI=

# Generate strong random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

APP_TIMEZONE=Asia/Kolkata

# WebAuthn / Passkeys
# WEBAUTHN_RP_ID and WEBAUTHN_ORIGIN accept comma-separated lists so you can
# add a real HTTPS origin (e.g. an ngrok/Cloudflare tunnel domain) alongside
# localhost when testing passkeys from a real phone -- WebAuthn only works
# on "localhost" or a genuine HTTPS origin, never a plain http://<lan-ip>.
WEBAUTHN_RP_NAME=InTime Attendance
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

CLIENT_URL=http://localhost:5173

# Office geofence (spec: 30m radius)
OFFICE_LATITUDE=22.512507119278705
OFFICE_LONGITUDE=88.39119924866769
OFFICE_RADIUS_METERS=30

# Attendance rules
OFFICE_START_TIME=09:30
OFFICE_END_TIME=17:30
SLIGHT_LATE_GRACE_MINUTES=15
MIN_WORKING_HOURS=8

# Used only by `npm run seed:admin` to create the first admin account.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
